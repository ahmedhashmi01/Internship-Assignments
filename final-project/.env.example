# Server
PORT=5000
# Allowed frontend origin(s) for CORS. Comma-separated for multiple deployed
# frontends, e.g. "https://app.example.com,https://staging.example.com".
CLIENT_ORIGIN=http://localhost:5173

# --- Persistence & authentication -------------------------------------------
# Leave MONGODB_URI empty to run the analyzer fully statelessly (no accounts,
# no guest limit, no history) — existing behavior. Set it to enable auth,
# per-user history, and the guest free-analysis limit.
# NOTE: when NODE_ENV=production, MONGODB_URI is REQUIRED and startup fails if
# it is missing or the database is unreachable (limits/history are never
# silently disabled in production).
MONGODB_URI=

# Auth (JWT bearer tokens). JWT_SECRET must be long and random; in production,
# startup rejects empty/placeholder/short (<32 chars) secrets.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Number of free analyses a guest may run before sign-up is required.
GUEST_ANALYSIS_LIMIT=1

# Per-IP rate limiting (abuse guard, NOT the guest-identity mechanism).
# Enabled by default outside NODE_ENV=test; set RATE_LIMIT_ENABLED to force it.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_SIGNUP_MAX=10
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_ANALYSIS_MAX=60

# Set to true when behind a load balancer/proxy so req.ip (used for rate
# limiting) reflects the real client IP.
TRUST_PROXY=false
# ----------------------------------------------------------------------------

# AI provider chain
# AI_MODE selects the routing mode:
#   automatic (default) - walk AI_PROVIDER_CHAIN in order, falling back on failure.
#                          Real providers only (Gemini, Groq, OpenRouter, Ollama) —
#                          mock is NEVER used here, even if misconfigured in below.
#                          If every provider fails, requests fail with a normalized
#                          AI_PROVIDERS_UNAVAILABLE error instead of silently
#                          falling back to fabricated mock analysis.
#   cloud               - Gemini, Groq, OpenRouter only (no Ollama, no mock)
#   private             - Ollama only (no cloud calls, no mock)
#   demo                - mock only — for local development/demos, not production
AI_MODE=automatic

# Ordered, comma-separated provider names tried in "automatic" mode. 'mock' is
# ignored here even if listed. Leave unset to fall back to the legacy
# single-provider AI_PROVIDER value (how automated tests select 'mock').
AI_PROVIDER_CHAIN=gemini,groq,openrouter,ollama

# Legacy single-provider selector — still honored when AI_PROVIDER_CHAIN and
# AI_MODE are both unset.
AI_PROVIDER=ollama

# How long (ms) a provider is skipped after a quota/rate-limit failure,
# unless the provider's own Retry-After response overrides it.
AI_PROVIDER_COOLDOWN_MS=300000

# Gemini (never exposed to the client — read server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (never exposed to the client — read server-side only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter — ordered, comma-separated model list; tried in order before
# OpenRouter itself is reported as failed to the outer provider chain.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=meta-llama/llama-3.1-8b-instruct:free

# Ollama (local, no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_NUM_PREDICT=600

MAX_RESUME_TEXT_LENGTH=20000

# Resume upload size limit (PDF/DOCX). Default 5 MB.
MAX_UPLOAD_FILE_SIZE_BYTES=5242880

# --- Job Posting URL import (SSRF-hardened fetch) ---------------------------
JOB_EXTRACT_TIMEOUT_MS=8000
JOB_EXTRACT_MAX_BYTES=2097152
JOB_EXTRACT_MAX_REDIRECTS=3
# Opt-in single LLM cleanup for noisy scraped HTML. Default off (no token use).
# JOB_EXTRACT_AI_CLEANUP=true

# --- Interview question generation (on-demand, token-conscious) -------------
INTERVIEW_MAX_QUESTIONS=10
INTERVIEW_NUM_PREDICT=700

# --- Live Job Discovery ------------------------------------------------------
# Off by default — the deterministic demo catalog is used until explicitly
# enabled, so Adzuna/Remotive credentials are never required for general
# server startup.
JOB_DISCOVERY_LIVE_ENABLED=false
# Safety cap on displayed results (all retrieved/deduplicated results up to
# this cap are shown — never an arbitrary top-3/top-4 truncation).
JOB_DISCOVERY_MAX_RESULTS=20
JOB_SEARCH_TIMEOUT_MS=8000

# Adzuna (role/title + location search). Leave empty to skip this provider.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Remotive (remote-job search) needs no credentials; this only toggles it off.
REMOTIVE_ENABLED=true

# Jooble — region-locked: the API key is issued per Jooble COUNTRY DOMAIN
# (e.g. sign up at pk.jooble.org for a key that returns Pakistani listings;
# uk.jooble.org for UK listings, etc. — a key from one domain will NOT return
# another country's jobs). Leave empty to skip this provider entirely.
JOOBLE_API_KEY=
# Optional default city/region passed to Jooble's "location" search field
# (e.g. "Karachi"). The country itself is already fixed by which domain the
# API key above came from, so this only narrows within that country.
JOOBLE_DEFAULT_LOCATION=

# Temporary diagnostic instrumentation (see server/src/utils/timingLog.js) — default off
# DEBUG_AI_TIMING=true

# Live AI trace logging — provider/model selection, sanitized model output,
# skill-match/ATS/scoring breakdowns (see server/src/utils/aiDebugLog.js).
# Default off. Never prints API keys, Authorization headers, provider error
# bodies, or raw prompts; emails/phones/URLs/addresses in logged content are
# redacted. The extra `debugModelOutput` field on worker results additionally
# requires NODE_ENV !== 'production'.
# DEBUG_AI_RESPONSES=true

# Client (optional override; defaults to Vite proxy /api)
# VITE_API_URL=http://localhost:5000/api
